<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pickorange_bringup</name>
  <version>0.1.0</version>
  <description>
    整机顶层 launch 与标定配置。所有几何参数集中在 config/transforms.yaml，
    不写死在 launch 里。见 docs/architecture_v2.md §7 / §9。
  </description>
  <maintainer email="bohn@example.com">BohnChen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>dummyarm_description</exec_depend>
  <exec_depend>pickorange_interfaces</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Dummy_URDF">

  
  <material name="material">
    <color rgba="0.910 0.678 0.137 1.0" />
  </material>

  
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/35_20Motor_Assembly.urdf.xacro" />
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/35_20Motor_Assembly_1.urdf.xacro" />
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/J1.urdf.xacro" />
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/J2J3.urdf.xacro" />
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/J4.urdf.xacro" />
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/base_link.urdf.xacro" />
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/tool0.urdf.xacro" />

  
  <xacro:assembly_35_20Motor_Assembly prefix="" />
  <xacro:assembly_35_20Motor_Assembly_1 prefix="" />
  <xacro:J1 prefix="" />
  <xacro:J2J3 prefix="" />
  <xacro:J4 prefix="" />
  <xacro:base_link prefix="" />
  <xacro:tool0 prefix="" />

  
  
  
  
  

  <joint name="_1" type="revolute">
    <parent link="base_link" />
    <child link="J1" />
    <origin xyz="-0.015000 0.035000 -0.037500" rpy="0.000000 0.000000 0.000000" />
    <axis xyz="0.000000 0.000000 1.000000" />
    <limit lower="-2.967060000" upper="2.967060000" effort="100.0" velocity="1.00" />
  </joint>

  <joint name="_2" type="revolute">
    <parent link="J1" />
    <child link="J2J3" />
    <origin xyz="-0.015000000 -0.035000000 0.039000000" rpy="-1.570795988 -0.262640848 -1.570796741" />
    <axis xyz="-0.000000000 -0.000000000 -1.000000000" />
    <limit lower="0.000000000" upper="2.844888000" effort="100.0" velocity="1.00" />
  </joint>

  <joint name="_3" type="revolute">
    <parent link="J2J3" />
    <child link="J4" />
    <origin xyz="0.141025000 0.037788000 0.033800000" rpy="0.000000000 -0.000000000 -3.140759373" />
    <axis xyz="-0.000000000 -0.000000000 -1.000000000" />
    <limit lower="-3.141593000" upper="-0.610865000" effort="100.0" velocity="1.00" />
  </joint>

  <joint name="_4" type="revolute">
    <parent link="J4" />
    <child link="J5" />
    <origin xyz="-0.027465 0.046475 -0.017000" rpy="0.261799 -1.570796 0.000000" />
    <axis xyz="0.000000 0.000000 1.000000" />
    <limit lower="-3.141593000" upper="3.141593000" effort="100.0" velocity="1.00" />
  </joint>

  <joint name="_5" type="revolute">
    <parent link="J5" />
    <child link="J6" />
    <origin xyz="-0.018100 0.000000 0.104500" rpy="1.570796 1.308997 -1.570796" />
    <axis xyz="0.000000 0.000000 1.000000" />
    <limit lower="-1.658063000" upper="1.658063000" effort="100.0" velocity="1.00" />
  </joint>

  <joint name="_6" type="revolute">
    <parent link="J6" />
    <child link="tool0" />
    <origin xyz="-0.060370 0.016176 -0.017100" rpy="-2.879793 1.570796 0.000000" />
    <axis xyz="0.000000 0.000000 1.000000" />
    <limit effort="100.0" velocity="1.00" lower="-12.566371000" upper="12.566371000" />
  </joint>


  <!-- ROS 2 control: generated generic system -->
  <ros2_control name="Dummy_URDF_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/Dummy_URDF_system/cmd</param>
      <param name="state_topic">sim/Dummy_URDF_system/state</param>
    </hardware>

    <joint name="_1">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="_2">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">2.844887</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="_3">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-3.141593</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="_4">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="_5">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="_6">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
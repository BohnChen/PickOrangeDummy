<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Dummy_URDF">

  <!-- Materials (shared across all assemblies) -->
  <material name="material">
    <color rgba="0.941 0.031 0.031 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/J1.urdf.xacro"/>
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/J2J3.urdf.xacro"/>
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/J4.urdf.xacro"/>
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/35_20Motor_Assembly.urdf.xacro"/>
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/35_20Motor_Assembly_1.urdf.xacro"/>
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/base_link.urdf.xacro"/>
  <xacro:include filename="$(find dummyarm_cad_description)/urdf/assemblies/tool0.urdf.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:J1 prefix=""/>
  <xacro:J2J3 prefix=""/>
  <xacro:J4 prefix=""/>
  <xacro:assembly_35_20Motor_Assembly prefix=""/>
  <xacro:assembly_35_20Motor_Assembly_1 prefix=""/>
  <xacro:base_link prefix=""/>
  <xacro:tool0 prefix=""/>

  <!-- Mount joints (cross-assembly connections) -->
  <!-- These define how assemblies connect to each other. -->
  <!-- When swapping a dummy assembly with a real part, -->
  <!-- update the include + macro call above, and adjust -->
  <!-- parent/child link names in the mount joint below. -->

  <joint name="Joint1" type="revolute">
    <parent link="base_link"/>
    <child link="J1"/>
    <origin xyz="-0.015000 0.035000 -0.037500" rpy="0.000000 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-2.967060" upper="2.967060" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Joint2" type="revolute">
    <parent link="J1"/>
    <child link="J2J3"/>
    <origin xyz="-0.015000 -0.035000 0.039000" rpy="1.570796 0.000000 1.570796"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="0.000000" upper="2.844887" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Joint3" type="revolute">
    <parent link="J2J3"/>
    <child link="J4"/>
    <origin xyz="0.141025 0.037788 0.033800" rpy="0.000000 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-2.530727" upper="0.000000" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Joint4" type="revolute">
    <parent link="J4"/>
    <child link="J5"/>
    <origin xyz="-0.027465 0.046475 -0.017000" rpy="0.261799 -1.570796 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-3.141593" upper="3.141593" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Joint5" type="revolute">
    <parent link="J5"/>
    <child link="J6"/>
    <origin xyz="-0.018100 0.000000 0.104500" rpy="1.570796 1.308997 -1.570796"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-1.658063" upper="1.658063" effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Joint6" type="revolute">
    <parent link="J6"/>
    <child link="tool0"/>
    <origin xyz="-0.060370 0.016176 -0.017100" rpy="-2.879793 1.570796 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="-3.141593" upper="3.141593" effort="100.0" velocity="1.00"/>
  </joint>

  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="serial_port" default="/dev/ttyACM1"/>

  <!-- ROS 2 control: generated generic system -->
  <ros2_control name="Dummy_URDF_system" type="system">
    <hardware>
      <xacro:if value="$(arg use_mock_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
        <param name="cmd_topic">sim/Dummy_URDF_system/cmd</param>
        <param name="state_topic">sim/Dummy_URDF_system/state</param>
      </xacro:if>
      <xacro:unless value="$(arg use_mock_hardware)">
        <plugin>dummyarm_hardware/DummyArmHardware</plugin>
        <param name="port">$(arg serial_port)</param>
        <param name="rate">20</param>
      </xacro:unless>
    </hardware>

    <joint name="Joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint6">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
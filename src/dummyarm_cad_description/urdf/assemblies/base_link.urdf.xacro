<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="base_link_macro">

  <xacro:macro name="base_link" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.014953 0.035152 -0.085142" rpy="0 0 0"/>
        <mass value="3.811528"/>
        <inertia ixx="7.001890e-03" ixy="-9.554389e-06" ixz="5.286073e-06"
                 iyy="6.555310e-03" iyz="9.169302e-05" izz="6.883350e-03"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="1.570796 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://dummyarm_cad_description/meshes/base_link/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="material"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="1.570796 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://dummyarm_cad_description/meshes/base_link/base_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

  </xacro:macro>

</robot>
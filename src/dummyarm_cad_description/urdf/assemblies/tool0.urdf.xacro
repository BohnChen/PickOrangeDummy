<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tool0_macro">

  <xacro:macro name="tool0" params="prefix">

    <!-- Links -->
    <link name="${prefix}tool0">
      <inertial>
        <origin xyz="0.000000 0.000000 0.002849" rpy="0 0 0"/>
        <mass value="0.073848"/>
        <inertia ixx="9.037478e-06" ixy="7.455686e-09" ixz="0.000000e+00"
                 iyy="2.847963e-05" iyz="0.000000e+00" izz="3.702439e-05"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.006000" rpy="0.000000 0.000000 1.570796"/>
        <geometry>
          <mesh filename="package://dummyarm_cad_description/meshes/tool0/tool0.dae" scale="1 1 1"/>
        </geometry>
        <material name="material"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.006000" rpy="0.000000 0.000000 1.570796"/>
        <geometry>
          <mesh filename="package://dummyarm_cad_description/meshes/tool0/tool0_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

  </xacro:macro>

</robot>
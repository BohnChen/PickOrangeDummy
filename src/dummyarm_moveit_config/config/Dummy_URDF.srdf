<?xml version="1.0" encoding="UTF-8"?>
<robot name="Dummy_URDF">
    <!-- GROUPS: Representation of a set of joints and links. -->
    <!-- arm: 5 轴空间定位机械臂 (负责将手腕 J6 送达目标位姿，绝不带动机具乱转) -->
    <group name="arm">
        <chain base_link="base_link" tip_link="J6"/>
        <joint name="Joint1"/>
        <joint name="Joint2"/>
        <joint name="Joint3"/>
        <joint name="Joint4"/>
        <joint name="Joint5"/>
    </group>

    <!-- cutter: 第 6 轴独立旋切剪切刀具 (专门用于采摘时的切削动作) -->
    <group name="cutter">
        <chain base_link="J6" tip_link="tool0"/>
        <joint name="Joint6"/>
    </group>

    <!-- END EFFECTOR: 将旋切刀具挂载在 5 轴机械臂手腕 J6 上 -->
    <end_effector name="cutter_ee" parent_link="J6" group="cutter" parent_group="arm"/>

    <!-- GROUP STATES: arm 组预设姿态 -->
    <group_state name="rest" group="arm">
        <joint name="Joint1" value="0.0"/>
        <joint name="Joint2" value="0.0"/>
        <joint name="Joint3" value="0.0"/>
        <joint name="Joint4" value="0.0"/>
        <joint name="Joint5" value="0.0"/>
    </group_state>

    <group_state name="home" group="arm">
        <joint name="Joint1" value="0.0"/>
        <joint name="Joint2" value="1.274090"/>
        <joint name="Joint3" value="-1.570796"/>
        <joint name="Joint4" value="0.0"/>
        <joint name="Joint5" value="0.0"/>
    </group_state>

    <!-- GROUP STATES: cutter 组预设姿态 (准备 / 旋切) -->
    <group_state name="ready" group="cutter">
        <joint name="Joint6" value="0.0"/>
    </group_state>

    <!-- DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link. -->
    <!-- 相邻连杆默认不进行自碰撞检测以大幅提升规划速度 -->
    <disable_collisions link1="base_link" link2="J1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="J2J3" reason="Never"/>
    <disable_collisions link1="J1" link2="J2J3" reason="Adjacent"/>
    <disable_collisions link1="J1" link2="J4" reason="Never"/>
    <disable_collisions link1="J2J3" link2="J4" reason="Adjacent"/>
    <disable_collisions link1="J4" link2="J5" reason="Adjacent"/>
    <disable_collisions link1="J5" link2="J6" reason="Adjacent"/>
    <disable_collisions link1="J6" link2="tool0" reason="Adjacent"/>
    <disable_collisions link1="J4" link2="J6" reason="Never"/>
    <disable_collisions link1="J5" link2="tool0" reason="Never"/>
</robot>
